{
  "name": "RoloDesk",
  "short_name": "RoloDesk",
  "id": "./RoloDesk_v0.3.4.html",
  "start_url": "./RoloDesk_v0.3.4.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0b131a",
  "theme_color": "#0b131a",
  "icons": [
    {
      "src": "rolodesk-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "rolodesk-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "text/plain",
            "text/markdown",
            "text/rtf",
            ".txt",
            ".md",
            ".markdown",
            ".rtf",
            ".script"
          ]
        }
      ]
    }
  }
}
